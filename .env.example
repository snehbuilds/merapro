# Copy to .env (make setup does this) and put real values in .env only: it is git-ignored.
# This file holds safe sandbox defaults; never commit a real secret here.
#
# Sandbox mode is ON by default, so a fresh clone cannot post to a real account by accident
# (docs/10 §3). Optional secrets are commented out: an EMPTY value counts as "set" (for
# example TELEGRAM_BOT_TOKEN= would make the API demand a webhook secret and refuse to boot).
# Uncomment a line only when you have its value.

# ---- core ----
MERA_ENV=development
# 32+ bytes. Generate: openssl rand -base64 48
MERA_SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
# Exactly 32 bytes, base64. Generate: openssl rand -base64 32
# Encrypts every connected account's tokens. Production refuses this example value.
# Back the real one up separately from the database: without it, every account must be
# reconnected after a restore.
MERA_MASTER_KEY=ZXhhbXBsZS1rZXktZG8tbm90LXVzZS1pbi1wcm9kISE=
MERA_PUBLIC_URL=http://localhost:3000
# The API's own address. For real platforms it must be public HTTPS: OAuth redirects come
# back to it, and Instagram and Threads download your images from it.
MERA_API_URL=http://localhost:8000
# What the browser uses to reach the API (OAuth redirects). Defaults to MERA_API_URL.
MERA_PUBLIC_API_URL=http://localhost:8000
# Shared by the web app's proxy and the API (16+ characters). With it the API records UI
# actions as "web" and sees each browser's own address for rate limits, login lockout and
# the audit log; without it every user shares the web server's address. Required when
# MERA_ENV=production. Generate: openssl rand -base64 32
# MERA_WEB_PROXY_SECRET=

# ---- database ----
# Owner role (migrations only) and the RLS-bound application role.
POSTGRES_PASSWORD=mera-dev-owner
# Host port for the Compose database (change if something else already uses 5432).
POSTGRES_HOST_PORT=5432
MERA_APP_DB_PASSWORD=mera-dev-app
# For running the API/tests on the host against the Compose database:
DATABASE_URL=postgresql+asyncpg://mera_app:mera-dev-app@localhost:5432/mera
DATABASE_MIGRATION_URL=postgresql+asyncpg://mera:mera-dev-owner@localhost:5432/mera
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ---- sandbox ----
# SANDBOX_MODE=true: fake platform accounts and the sandbox phone, never a real post.
# Turn it off (in .env) to connect real accounts with the platform apps below.
SANDBOX_MODE=true
# SANDBOX_LLM=true: the deterministic offline writer, no API keys needed. Set false and add
# a provider key below to draft with real models.
SANDBOX_LLM=true
SANDBOX_MEDIA=true
# Where uploads and renditions are stored (a volume in Compose).
MEDIA_ROOT=var/media

# ---- LLM providers ----
# Configure provider keys in Workspace settings → AI & LLM Model Providers. They are
# workspace-scoped; do not place customer provider keys in this deployment environment.
# Models per agent are selected in the Agents screen.
# RESEARCH_MODEL=anthropic/claude-haiku-4-5
# EMBEDDING_MODEL=openai/text-embedding-3-small
# WRITER_MODEL=anthropic/claude-sonnet-4-5
# EDITOR_MODEL=anthropic/claude-sonnet-4-5
# HASHTAG_MODEL=openai/gpt-5-mini
# Spend caps per workspace (USD): research and drafting per day, everything per month.
# RESEARCH_DAILY_COST_CAP_USD=2.0
# DRAFTING_DAILY_COST_CAP_USD=5.0
# WORKSPACE_MONTHLY_COST_CAP_USD=100.0

# ---- social platform apps (M8; used only with SANDBOX_MODE=false) ----
# One developer app per platform; every account on that platform connects through it.
# Register this redirect URI in each app (replace <platform>):
#   {MERA_API_URL}/api/v1/social-accounts/oauth/<platform>/callback
#   <platform> = linkedin_member, linkedin_organization, facebook, instagram, threads, x
# See docs/runbooks/connecting-social-accounts.md for scopes and review steps.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Facebook Pages and Instagram (one Meta app):
# META_APP_ID=
# META_APP_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# ---- Telegram approval bot (M7) ----
# Without a token, cards go to the sandbox phone at /w/<workspace>/sandbox.
# See docs/runbooks/telegram-bot-setup.md.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Required with a token, 16+ characters. Generate: openssl rand -hex 24
# TELEGRAM_WEBHOOK_SECRET=
# webhook (servers) or polling (local, no public HTTPS; run python -m mera.bots.poll)
# TELEGRAM_MODE=webhook

# ---- outbound email (verification and invitation links) ----
# Any SMTP relay. Unset: sandbox keeps the mail in memory and shows links in the app;
# outside sandbox, email verification is refused and invitation links are shared by hand.
# Check it with: make preflight args="--live --send-test-email you@example.com"
# SMTP_HOST=
# SMTP_PORT=587
# starttls (port 587), ssl (port 465), or none (development only)
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Required with SMTP_HOST:
# SMTP_FROM=Mera <mera@example.com>

# ---- sign in with Google / Microsoft (optional; unset = disabled) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ---- limits and network ----
RATE_LIMIT_ENABLED=true
MAX_ACCOUNTS_PER_WORKSPACE=25
# Use the OS trust store for outbound fetches (a corporate TLS proxy's CA lives there).
HTTP_SYSTEM_TRUST_STORE=true
# Addresses of a reverse proxy placed directly in front of api or bots whose
# X-Forwarded-For uvicorn should believe (comma-separated IPs or CIDRs). Browser traffic
# through the web app does not need this; it uses MERA_WEB_PROXY_SECRET.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Docker image builds behind a TLS-intercepting proxy: export CORP_CA_BUNDLE=/path/to/ca.pem
# in your shell (not here) before `make up`; see GUIDE.md.

# ---- observability ----
LOG_LEVEL=INFO
LOG_FORMAT=json
# OTLP/HTTP collector base URL. Mera exports both logs and traces to /v1/{logs,traces}.
# Example: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana Cloud: copy this exact value from its OpenTelemetry connection tile. The
# ``%20`` in Basic%20 is required in dotenv configuration for Python.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20BASE64_INSTANCE_ID_COLON_TOKEN
